{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "_comment" : "SQLite Connection String",
    "DefaultConnection": "Data Source=app.db"
  },
  "JwtSettings": {
    "ExpiryDays": 7,
    "Issuer":"MyDotNetWebsiteApi",
    "Audience":"MyDotNetWebsiteFrontend"
  },
  "CorsSettings": {
    "AllowedOrigin": "http://localhost:5173"
  },
  "MediaItemSettings": {
    "RandomAmountHardLimit":5
  }
}
